#: app/main.py:56
msgid "Too many requests"
msgstr "طلبات كثيرة جداً"

#: app/api/routes/utils.py:28
msgid "Test email sent"
msgstr "تم إرسال رسالة اختبار"

#: app/auth/exceptions.py:7
msgid "Incorrect email or password"
msgstr "البريد الإلكتروني أو كلمة المرور غير صحيحة"

#: app/auth/exceptions.py:12
msgid "Inactive user"
msgstr "المستخدم غير نشط"

#: app/auth/exceptions.py:17
msgid "Invalid token"
msgstr "الرمز غير صالح"

#: app/auth/exceptions.py:22
msgid "Could not validate credentials"
msgstr "تعذر التحقق من بيانات الاعتماد"

#: app/auth/router.py:86
msgid "If that email is registered, we sent a password recovery link"
msgstr "إذا كان هذا البريد الإلكتروني مسجلاً، فقد أرسلنا رابط استعادة كلمة المرور"

#: app/auth/router.py:109 app/users/router.py:116
msgid "Password updated successfully"
msgstr "تم تحديث كلمة المرور بنجاح"

#: app/core/validation_i18n.py:10
#, python-brace-format
msgid "String should have at least {min_length} characters"
msgstr "يجب أن يحتوي على {min_length} حرف على الأقل"

#: app/core/validation_i18n.py:11
#, python-brace-format
msgid "String should have at most {max_length} characters"
msgstr "يجب ألا يتجاوز {max_length} حرفاً"

#: app/core/validation_i18n.py:12
msgid "Field required"
msgstr "هذا الحقل مطلوب"

#: app/core/validation_i18n.py:13
#, python-brace-format
msgid "Value error, {error}"
msgstr "خطأ في القيمة، {error}"

#: app/core/validation_i18n.py:14
msgid "Input should be a valid string"
msgstr "يجب أن يكون الإدخال نصاً صالحاً"

#: app/core/validation_i18n.py:15
msgid "Input should be a valid boolean"
msgstr "يجب أن يكون الإدخال قيمة منطقية"

#: app/core/validation_i18n.py:16
msgid "Input should be a valid integer"
msgstr "يجب أن يكون الإدخال عدداً صحيحاً"

#: app/emails/service.py:74
#, python-brace-format
msgid "{project_name} - Test email"
msgstr "{project_name} - رسالة اختبار"

#: app/emails/service.py:76
#, python-brace-format
msgid "Test email for: {email}"
msgstr "رسالة اختبار لـ: {email}"

#: app/emails/service.py:88
#, python-brace-format
msgid "{project_name} - Password recovery for user {email}"
msgstr "{project_name} - استعادة كلمة المرور للمستخدم {email}"

#: app/emails/service.py:97
#, python-brace-format
msgid "{project_name} - Password Recovery"
msgstr "{project_name} - استعادة كلمة المرور"

#: app/emails/service.py:101
#, python-brace-format
msgid "Hello {username}"
msgstr "مرحباً {username}"

#: app/emails/service.py:104
msgid ""
"We've received a request to reset your password. You can do it by "
"clicking the button below:"
msgstr ""
"لقد تلقينا طلباً لإعادة تعيين كلمة المرور الخاصة بك. يمكنك القيام بذلك "
"عبر النقر على الزر أدناه:"

#: app/emails/service.py:109
msgid "Reset password"
msgstr "إعادة تعيين كلمة المرور"

#: app/emails/service.py:111
msgid "Or copy and paste the following link into your browser:"
msgstr "أو انسخ الرابط التالي والصقه في متصفحك:"

#: app/emails/service.py:114
#, python-brace-format
msgid "This password will expire in {valid_hours} hours."
msgstr "تنتهي صلاحية كلمة المرور هذه خلال {valid_hours} ساعات."

#: app/emails/service.py:120
msgid "If you didn't request a password recovery you can disregard this email."
msgstr "إذا لم تطلب استعادة كلمة المرور فيمكنك تجاهل هذه الرسالة."

#: app/emails/service.py:135
#, python-brace-format
msgid "{project_name} - New account for user {username}"
msgstr "{project_name} - حساب جديد للمستخدم {username}"

#: app/emails/service.py:142
#, python-brace-format
msgid "{project_name} - New Account"
msgstr "{project_name} - حساب جديد"

#: app/emails/service.py:146
msgid "Welcome to your new account!"
msgstr "مرحباً بك في حسابك الجديد!"

#: app/emails/service.py:147
msgid "Here are your account details:"
msgstr "إليك تفاصيل حسابك:"

#: app/emails/service.py:148
#, python-brace-format
msgid "Username: {username}"
msgstr "اسم المستخدم: {username}"

#: app/emails/service.py:149
msgid "Go to Dashboard"
msgstr "الذهاب إلى لوحة التحكم"

#: app/items/exceptions.py:7
msgid "Item not found"
msgstr "العنصر غير موجود"

#: app/items/exceptions.py:12
msgid "Not enough permissions"
msgstr "لا توجد صلاحيات كافية"

#: app/items/router.py:109
msgid "Item deleted successfully"
msgstr "تم حذف العنصر بنجاح"

#: app/users/exceptions.py:7
msgid "The user with this email already exists in the system"
msgstr "المستخدم بهذا البريد الإلكتروني موجود بالفعل في النظام"

#: app/users/exceptions.py:12
msgid "User with this email already exists"
msgstr "المستخدم بهذا البريد الإلكتروني موجود بالفعل"

#: app/users/exceptions.py:17
msgid "Incorrect password"
msgstr "كلمة المرور غير صحيحة"

#: app/users/exceptions.py:22
msgid "New password cannot be the same as the current one"
msgstr "لا يمكن أن تكون كلمة المرور الجديدة مطابقة للحالية"

#: app/users/exceptions.py:27
msgid "Super users are not allowed to delete themselves"
msgstr "لا يُسمح للمستخدمين المميزين بحذف أنفسهم"

#: app/users/exceptions.py:32
msgid "User not found"
msgstr "المستخدم غير موجود"

#: app/users/exceptions.py:37
msgid "The user doesn't have enough privileges"
msgstr "لا يمتلك المستخدم صلاحيات كافية"

#: app/users/router.py:141 app/users/router.py:226
msgid "User deleted successfully"
msgstr "تم حذف المستخدم بنجاح"

